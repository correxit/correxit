{
  "jupyter.lab.shortcuts": [],
  "title": "Correxit UI",
  "description": "Correxit notebook annotations, sidebar, and toolbar buttons",
  "type": "object",
  "properties": {
    "annotate": {
      "title": "Annotate Correxit workbooks",
      "description": "Whether to show workbook annotations in the notebook UI",
      "type": "boolean",
      "default": true
    }
  },
  "jupyter.lab.toolbars": {
    "Cell": [
      {
        "name": "correxit-add-answerable",
        "command": "correxit:add",
        "args": { "correxit:cell-toolbar": true, "is": "answerable" },
        "label": ""
      },
      {
        "name": "correxit-add-comparable",
        "command": "correxit:add",
        "args": { "correxit:cell-toolbar": true, "is": "comparable" },
        "label": ""
      },
      {
        "name": "correxit-add-correctable",
        "command": "correxit:add",
        "args": { "correxit:cell-toolbar": true, "is": "correctable" },
        "label": ""
      },
      {
        "name": "correxit-correct",
        "command": "correxit:correct",
        "args": { "correxit:cell-toolbar": true },
        "label": ""
      },
      {
        "name": "correxit-toggle",
        "command": "correxit:toggle",
        "args": { "correxit:cell-toolbar": true },
        "label": ""
      }
    ],
    "Notebook": [
      {
        "name": "correxit-convert",
        "command": "correxit:convert",
        "label": ""
      },
      {
        "name": "correxit-correct",
        "command": "correxit:correct",
        "label": ""
      },
      {
        "name": "correxit-lock",
        "command": "correxit:lock",
        "icon": "correxit:unlocked",
        "label": ""
      },
      {
        "name": "correxit-unlock",
        "command": "correxit:unlock",
        "label": ""
      }
    ]
  },
  "additionalProperties": false
}
