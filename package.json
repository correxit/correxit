{
    "name": "correxit",
    "version": "1.29.0",
    "workspaces": [
        "lite/brand"
    ],
    "description": "Correxit is a JupyterLab extension and the third-person singular perfect active indicative conjugation of the Latin verb corrigere",
    "keywords": [
        "jupyter",
        "jupyterlab",
        "jupyterlab-extension"
    ],
    "homepage": "https://correx.it",
    "bugs": {
        "url": "https://github.com/QuantStack/correxit/issues"
    },
    "license": "AGPL-3.0-only",
    "author": {
        "name": "A. T. Darian",
        "email": "correxit@darian.link"
    },
    "files": [
        "examples/*.mjs",
        "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,mjs,mjs.map,json,png,svg,woff2,ttf}",
        "scripts/*.{cjs,mjs}",
        "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
        "src/**/*.{ts,tsx}",
        "schema/*.json"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "style": "style/index.css",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./node": {
            "types": "./lib/node.d.ts",
            "import": "./lib/node.mjs",
            "default": "./lib/node.mjs"
        },
        "./lib/*": "./lib/*",
        "./package.json": "./package.json",
        "./schema/*": "./schema/*",
        "./style/*": "./style/*"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/QuantStack/correxit.git"
    },
    "scripts": {
        "build": "jlpm build:lib && jlpm build:node && jlpm build:labextension:dev",
        "build:prod": "jlpm build:npm && jlpm build:labextension",
        "build:labextension": "jupyter-builder build .",
        "build:labextension:dev": "jupyter-builder build --development True .",
        "build:lib": "tsc --sourceMap",
        "build:lib:prod": "tsc",
        "build:node": "node scripts/build-node.cjs",
        "build:npm": "jlpm clean:lib && jlpm build:lib:prod && jlpm build:node",
        "build:lite": "jlpm build:lite:app && jlpm build:site",
        "build:lite:app": "jlpm build:lite:brand && rimraf lite/_output/extensions/correxit && cd lite && jupyter lite build --output-dir _output --XeusAddon.mount_jupyterlite_content=True && jlpm link:lite",
        "build:lite:brand": "jupyter-builder build lite/brand",
        "build:api": "typedoc",
        "build:site": "jlpm build:api && node site/build.mjs",
        "link:lite": "node lite/link.mjs",
        "clean": "jlpm clean:lib",
        "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
        "clean:lintcache": "rimraf .eslintcache .stylelintcache",
        "clean:labextension": "rimraf correxit/labextension correxit/_version.py",
        "clean:coverage": "rimraf coverage junit.xml",
        "clean:ui-tests": "rimraf ui-tests/test-results ui-tests/playwright-report ui-tests/screenshots ui-tests/demo.webm",
        "clean:lite": "rimraf lite/_output lite/.jupyterlite.doit.db lite/brand/labextension site/_api site/_output",
        "clean:all": "jlpm clean:lib && jlpm clean:labextension && jlpm clean:lintcache && jlpm clean:coverage && jlpm clean:ui-tests && jlpm clean:lite",
        "eslint": "jlpm eslint:check --fix",
        "eslint:check": "eslint . lite/brand/*.js site/*.mjs --cache --ext .ts,.tsx",
        "install:extension": "jlpm build",
        "lint": "jlpm stylelint && jlpm prettier && jlpm eslint",
        "lint:check": "jlpm stylelint:check && jlpm prettier:check && jlpm eslint:check",
        "lint:site": "prettier --check \"site/**/*{.mjs,.css,.html,.md}\" && stylelint \"site/style.css\"",
        "prepack": "jlpm build:npm",
        "prettier": "jlpm prettier:base --write --list-different",
        "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.mjs,.cjs,.css,.html,.json,.md}\"",
        "prettier:check": "jlpm prettier:base --check",
        "stylelint": "jlpm stylelint:check --fix",
        "stylelint:check": "stylelint --cache \"style/**/*.css\" \"site/style.css\"",
        "test": "jest --coverage",
        "test:node": "jlpm build:lib && jlpm build:node && node scripts/test-node.mjs",
        "test:site": "node --test site/test.mjs",
        "watch": "run-p watch:src watch:labextension",
        "watch:src": "tsc -w --sourceMap",
        "watch:labextension": "jupyter-builder watch .",
        "serve": "python -m http.server 8888 --directory site/_output",
        "record-readme-video": "cd ui-tests && jlpm playwright test --config playwright.demo.config.js tests/demo.spec.ts && mv $(find test-results -name '*.webm' | sort | tail -1) demo.webm",
        "render-github-avatar": "cd ui-tests && node render-github-avatar.mjs"
    },
    "dependencies": {
        "@jupyter-notebook/tree": "^7.5.4",
        "@jupyterlab/application": "^4.5.5",
        "@jupyterlab/apputils": "^4.5.5",
        "@jupyterlab/cells": "^4.5.5",
        "@jupyterlab/codeeditor": "^4.5.5",
        "@jupyterlab/coreutils": "^6.5.5",
        "@jupyterlab/docmanager": "^4.5.5",
        "@jupyterlab/docregistry": "^4.5.5",
        "@jupyterlab/filebrowser": "^4.5.5",
        "@jupyterlab/launcher": "^4.5.5",
        "@jupyterlab/nbformat": "^4.5.5",
        "@jupyterlab/notebook": "^4.5.5",
        "@jupyterlab/rendermime": "^4.5.5",
        "@jupyterlab/services": "^7.5.5",
        "@jupyterlab/settingregistry": "^4.5.5",
        "@jupyterlab/statusbar": "^4.5.5",
        "@jupyterlab/translation": "^4.5.5",
        "@jupyterlab/ui-components": "^4.5.5",
        "@lumino/algorithm": "^2.0.4",
        "@lumino/commands": "^2.3.3",
        "@lumino/coreutils": "^2.2.2",
        "@lumino/disposable": "^2.1.5",
        "@lumino/polling": "^2.1.5",
        "@lumino/signaling": "^2.1.5",
        "@lumino/widgets": "^2.7.3",
        "jupyter-secrets-manager": "^0.5.0",
        "openpgp": "^6.0.0",
        "react": "^18.2.0"
    },
    "devDependencies": {
        "@jupyter/builder": "^1.0.2",
        "@jupyterlab/galata": "^5.6.0",
        "@jupyterlab/testutils": "^4.6.0",
        "@picocss/pico": "^2.1.1",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/npm": "^12.0.1",
        "@types/jest": "^29.2.0",
        "@types/json-schema": "^7.0.11",
        "@types/node": "^22.15.21",
        "@types/react": "^18.0.26",
        "@types/react-addons-linked-state-mixin": "^0.14.22",
        "@typescript-eslint/eslint-plugin": "^6.1.0",
        "@typescript-eslint/parser": "^6.1.0",
        "baseline-browser-mapping": "2.10.16",
        "css-loader": "^6.7.1",
        "eslint": "^8.36.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "jest": "^29.2.0",
        "marked": "^17.0.6",
        "mkdirp": "^1.0.3",
        "mustache": "^4.2.0",
        "npm-run-all2": "^7.0.1",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.1",
        "semantic-release": "^24.0.0",
        "source-map-loader": "^1.0.2",
        "style-loader": "^3.3.1",
        "stylelint": "^15.10.1",
        "stylelint-config-recommended": "^13.0.0",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-csstree-validator": "^3.0.0",
        "stylelint-prettier": "^4.0.0",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.12.0",
        "typescript": "~5.0.2",
        "webpack": "^5.76.1",
        "yjs": "^13.5.0"
    },
    "resolutions": {
        "@jupyter-notebook/tree": "7.6.0",
        "@jupyterlab/application": "4.6.0",
        "@jupyterlab/apputils": "4.7.0",
        "@jupyterlab/cells": "4.6.0",
        "@jupyterlab/codeeditor": "4.6.0",
        "@jupyterlab/codemirror": "4.6.0",
        "@jupyterlab/console": "4.6.0",
        "@jupyterlab/core-meta": "4.6.0",
        "@jupyterlab/coreutils": "6.6.0",
        "@jupyterlab/debugger": "4.6.0",
        "@jupyterlab/docmanager": "4.6.0",
        "@jupyterlab/docregistry": "4.6.0",
        "@jupyterlab/documentsearch": "4.6.0",
        "@jupyterlab/filebrowser": "4.6.0",
        "@jupyterlab/fileeditor": "4.6.0",
        "@jupyterlab/lsp": "4.6.0",
        "@jupyterlab/nbformat": "4.6.0",
        "@jupyterlab/notebook": "4.6.0",
        "@jupyterlab/rendermime": "4.6.0",
        "@jupyterlab/services": "7.6.0",
        "@jupyterlab/settingregistry": "4.6.0",
        "@jupyterlab/statedb": "4.6.0",
        "@jupyterlab/statusbar": "4.6.0",
        "@jupyterlab/testing": "4.6.0",
        "@jupyterlab/translation": "4.6.0",
        "@jupyterlab/ui-components": "4.6.0",
        "@jupyter/builder": "1.0.2",
        "@jupyterlab/galata": "5.6.0",
        "@jupyterlab/testutils": "4.6.0",
        "@lumino/widgets": "2.8.0"
    },
    "sideEffects": [
        "style/*.css",
        "style/index.js"
    ],
    "styleModule": "style/index.js",
    "publishConfig": {
        "access": "public"
    },
    "jupyterlab": {
        "discovery": {
            "server": {
                "managers": [
                    "pip"
                ],
                "base": {
                    "name": "correxit"
                }
            }
        },
        "extension": true,
        "outputDir": "correxit/labextension",
        "schemaDir": "schema",
        "sharedPackages": {
            "@jupyterlab/application": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/apputils": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/cells": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/codeeditor": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/coreutils": {
                "requiredVersion": "^6.5.5"
            },
            "@jupyterlab/docmanager": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/docregistry": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/filebrowser": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/nbformat": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/notebook": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/rendermime": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/services": {
                "requiredVersion": "^7.5.5"
            },
            "@jupyterlab/settingregistry": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/statusbar": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/translation": {
                "requiredVersion": "^4.5.5"
            },
            "@jupyterlab/ui-components": {
                "requiredVersion": "^4.5.5"
            }
        }
    },
    "eslintIgnore": [
        "node_modules",
        "dist",
        "coverage",
        "**/*.d.ts",
        "tests",
        "**/__tests__",
        "ui-tests"
    ],
    "eslintConfig": {
        "extends": [
            "eslint:recommended",
            "plugin:@typescript-eslint/eslint-recommended",
            "plugin:@typescript-eslint/recommended",
            "plugin:prettier/recommended"
        ],
        "parser": "@typescript-eslint/parser",
        "parserOptions": {
            "project": "tsconfig.json",
            "sourceType": "module"
        },
        "plugins": [
            "@typescript-eslint",
            "react-hooks"
        ],
        "overrides": [
            {
                "files": [
                    "lite/brand/*.js"
                ],
                "env": {
                    "browser": true
                },
                "parserOptions": {
                    "project": null
                }
            },
            {
                "files": [
                    "site/*.mjs"
                ],
                "env": {
                    "node": true
                },
                "parserOptions": {
                    "project": null
                }
            }
        ],
        "rules": {
            "semi": "error",
            "@typescript-eslint/naming-convention": [
                "error",
                {
                    "selector": "interface",
                    "format": [
                        "PascalCase"
                    ],
                    "custom": {
                        "regex": "^I[A-Z]",
                        "match": true
                    }
                }
            ],
            "@typescript-eslint/no-unused-vars": [
                "warn",
                {
                    "args": "none",
                    "varsIgnorePattern": "^_"
                }
            ],
            "@typescript-eslint/no-explicit-any": "off",
            "@typescript-eslint/no-namespace": "off",
            "@typescript-eslint/no-use-before-define": "off",
            "@typescript-eslint/quotes": [
                "error",
                "single",
                {
                    "avoidEscape": true,
                    "allowTemplateLiterals": false
                }
            ],
            "curly": [
                "error",
                "multi-or-nest",
                "consistent"
            ],
            "eqeqeq": "error",
            "prefer-arrow-callback": "error",
            "react-hooks/exhaustive-deps": "error",
            "react-hooks/rules-of-hooks": "error"
        }
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "auto",
        "overrides": [
            {
                "files": "package.json",
                "options": {
                    "tabWidth": 4
                }
            }
        ]
    },
    "stylelint": {
        "extends": [
            "stylelint-config-recommended",
            "stylelint-config-standard",
            "stylelint-prettier/recommended"
        ],
        "plugins": [
            "stylelint-csstree-validator"
        ],
        "rules": {
            "csstree/validator": true,
            "property-no-vendor-prefix": null,
            "selector-class-pattern": "^([a-z][A-z\\d]*)(-[A-z\\d]+)*$",
            "selector-no-vendor-prefix": null,
            "value-no-vendor-prefix": null
        }
    }
}
