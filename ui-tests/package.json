{
  "name": "correxit-ui-tests",
  "version": "1.0.0",
  "description": "JupyterLab/Correxit Integration Tests",
  "private": true,
  "scripts": {
    "start": "jupyter lab --config jupyter_server_test_config.py",
    "screenshots": "jlpm playwright test -c playwright.screenshots.config.js",
    "test": "jlpm playwright test",
    "test:update": "jlpm playwright test --update-snapshots"
  },
  "devDependencies": {
    "@jupyterlab/galata": "~5.5.5",
    "@playwright/test": "1.57.0"
  },
  "resolutions": {
    "@playwright/test": "1.57.0",
    "playwright": "1.57.0",
    "playwright-core": "1.57.0"
  }
}
